// Soul Brass
// SFZ is CC0
// Samples are licensed from originals

#define $HOME /zynthian/zynthian-data/soundfonts/sfz

<control>
label_cc102=trombone volume
set_cc102=64
label_cc103=trombone octave shift
set_cc103=64
label_cc104=tenor sax volume
set_cc104=64
label_cc105=tenor sax octave shift
set_cc105=64
label_cc106=alto sax volume
set_cc106=64
label_cc107=alto sax octave shift
set_cc107=64
label_cc108=trumpet volume
set_cc108=64
label_cc109=trumpet octave shift
set_cc109=64

<global> volume=10


// === Trombone
// from VSCO2/TromboneSus.sfz
<control> default_path=$HOME/VSCO2/Brass/Tenor Trombone/sus/
<master> amplitude_cc102=100

// Trombone, no octave shift
<group> ampeg_attack=0.001 ampeg_release=0.6 ampeg_dynamic=1 locc103=64
