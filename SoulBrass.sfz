// === Tenor Sax
// from Brass/TenorSax/tenorsax_vib_legmode.sfz
<control> default_path=$HOME/Brass/TenorSax/

<master> amplitude_cc104=100
ampeg_attack=.1 ampeg_release=.1

// Tenor sax, plays one octave lower
<group> hicc105=63
<region> sample=Vibrato/2_E_a.wav lovel=64 pitch_keycenter=e3 hikey=f#3 offset=25809
